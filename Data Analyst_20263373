        "plt.xlabel('XP Balance Amount')\n",
        "plt.ylabel('Frequency (User Count)')\n",
        "plt.tight_layout()\n",
        "plt.savefig('scope_b_xp_balance_distribution.png', dpi=300)\n",
        "plt.show()"
