        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Ensure we have our clean rewards dataset loaded\n",
        "user_rew_clean = rewards_sheets['Users_1000_Clean'].copy()\n",
        "user_rew_clean['registration_datetime'] = pd.to_datetime(user_rew_clean['registration_datetime'])\n",
        "user_rew_clean['last_login_datetime'] = pd.to_datetime(user_rew_clean['last_login_datetime'])\n",
        "\n",
        "print(\"=== 1. Core Anomaly Investigation (Simulated Dataset) ===\")\n",
        "\n",
        "# Investigate negative days since registration\n",
        "neg_days = user_rew_clean[user_rew_clean['days_since_registration'] < 0].copy()\n",
        "print(f\"\\nIn the simulated dataset, number of records with negative registration days: {len(neg_days)}\")\n",
        "# Establish dataset anchor date\n",
        "max_reg_date = user_rew_clean['registration_datetime'].max()\n",
        "print(f\"In the simulated dataset, the latest registration date is: {max_reg_date}\")\n",
        "# Inspect negative records relative to latest date\n",
        "neg_days['calculated_diff_days'] = (max_reg_date - neg_days['registration_datetime']).dt.total_seconds() / (24 * 3600)\n",
        "display(neg_days[['user_id', 'registration_datetime', 'days_since_registration', 'calculated_diff_days']])\n",
        "\n",
        "# Investigate relation between missing last login and status\n",
        "missing_last_login_df = user_rew_clean[user_rew_clean['last_login_datetime'].isnull()]\n",
        "print(f\"\\nIn the simulated dataset, number of records with missing last login: {len(missing_last_login_df)}\")\n",
        "print(\"In the simulated dataset, crosstab of missing last login by Account Status and Onboarding Status:\")\n",
        "cross_audit = pd.crosstab(\n",
        "    missing_last_login_df['account_status'].fillna('Missing'),\n",
        "    missing_last_login_df['onboarding_status'].fillna('Missing'),\n",
        "    margins=True\n",
        ")\n",
        "display(cross_audit)"
