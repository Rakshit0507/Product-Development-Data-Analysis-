      "source": [
        "# 8. User Segmentation mapping\n",
        "def classify_segment(row):\n",
        "    if row['days_since_registration'] <= 30:\n",
        "        return 'New'\n",
        "    elif row['is_active_30d'] == 'Yes':\n",
        "        return 'Active'\n",
        "    elif row['active_days'] == 0:\n",
        "        return 'Inactive'\n",
        "    else:\n",
        "        return 'Dormant'\n",
        "\n",
        "user_rew['lifecycle_segment'] = user_rew.apply(classify_segment, axis=1)\n",
        "segment_counts = user_rew['lifecycle_segment'].value_counts()\n",
        "segment_pct = user_rew['lifecycle_segment'].value_counts(normalize=True) * 100\n",
        "\n",
        "segment_summary_df = pd.DataFrame({\n",
        "    'Count': segment_counts,\n",
        "    'Percentage': segment_pct\n",
        "})\n",
        "print(\"In the simulated dataset, User Segmentation is:\")\n",
        "display(segment_summary_df)"
      ],
