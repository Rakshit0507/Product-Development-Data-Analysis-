        "# 3. Define Lifecycle Segmentation\n",
        "def segment_lifecycle(row):\n",
        "    # New Users: Registered within the last 30 days\n",
        "    if row['days_since_registration'] <= 30:\n",
        "        return 'New'\n",
        "    # Active Users: Active in last 30 days\n",
        "    elif row['is_active_30d'] == 'Yes':\n",
        "        return 'Active'\n",
        "    # Inactive: No active days recorded and not active 30d\n",
        "    elif row['active_days'] == 0:\n",
        "        return 'Inactive'\n",
        "    # Dormant: Has active history but inactive in last 30 days\n",
        "    else:\n",
        "        return 'Dormant'\n",
        "\n",
        "user_rew_clean['lifecycle_segment'] = user_rew_clean.apply(segment_lifecycle, axis=1)\n",
        "segments_summary = user_rew_clean['lifecycle_segment'].value_counts()\n",
        "\n",
        "print(\"In the simulated dataset, user lifecycle segmentation results are:\")\n",
        "for k, v in segments_summary.items():\n",
        "    print(f\" - {k}: {v} users\")\n",
        "\n",
        "# XP Balance description by segment\n",
        "xp_by_seg = user_rew_clean.groupby('lifecycle_segment')['xp_balance'].mean()\n",
        "print(\"\\nIn the simulated dataset, the average XP balance by segment is:\")\n",
        "for k, v in xp_by_seg.items():\n",
        "    print(f\" - {k}: {v:.1f} XP\")\n"
      ],
      "execution_count": 25,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
