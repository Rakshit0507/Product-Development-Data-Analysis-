        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Ensure we have our clean rewards dataset loaded\n",
        "user_rew_clean = rewards_sheets['Users_1000_Clean'].copy()\n",
        "user_rew_clean['last_login_datetime'] = pd.to_datetime(user_rew_clean['last_login_datetime'], errors='coerce')\n",
        "\n",
        "# --- 1. Anomalies Investigation & Documentation ---\n",
        "print(\"=== DATA QUALITY AUDIT & ANOMALY INVESTIGATION ===\")\n",
        "\n",
        "# Anomaly A: Negative days_since_registration\n",
        "neg_days_df = user_rew_clean[user_rew_clean['days_since_registration'] < 0]\n",
        "print(f\"\\nIn the simulated dataset, number of records with negative days_since_registration: {len(neg_days_df)}\")\n",
        "display(neg_days_df[['user_id', 'full_name', 'registration_datetime', 'days_since_registration']])\n",
        "\n",
        "# Anomaly B: Missing last_login_datetime\n",
        "missing_login_df = user_rew_clean[user_rew_clean['last_login_datetime'].isnull()]\n",
        "print(f\"\\nIn the simulated dataset, number of records with missing last_login_datetime: {len(missing_login_df)}\")\n",
        "print(f\"In the simulated dataset, unique account statuses for users missing last login: {missing_login_df['account_status'].unique()}\")\n",
        "print(f\"In the simulated dataset, unique onboarding statuses for users missing last login: {missing_login_df['onboarding_status'].unique()}\")\n",
        "\n",
        "# --- 2. Chart Configurations ---\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "plt.rcParams['font.size'] = 11\n",
        "\n",
        "# A. Account Status Bar Chart\n",
        "plt.figure(figsize=(8, 4.5))\n",
        "ax_status = sns.countplot(data=user_rew_clean, x='account_status', palette='viridis', edgecolor='black', hue='account_status', legend=False)\n",
        "for c in ax_status.containers:\n",
        "    ax_status.bar_label(c, weight='bold', padding=3)\n",
        "plt.title('In the simulated dataset: Account Status Distribution', weight='bold', pad=15)\n",
        "plt.xlabel('Account Status')\n",
        "plt.ylabel('User Count')\n",
        "plt.tight_layout()\n",
        "plt.savefig('account_status_bar.png', dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# B. Email Verification Pie Chart\n",
        "plt.figure(figsize=(6, 6))\n",
        "email_counts = user_rew_clean['email_verification_status'].value_counts()\n",
        "plt.pie(email_counts, labels=email_counts.index, autopct='%1.1f%%', startangle=90, colors=['#2ec4b6', '#ff9f1c'],\n",
        "        wedgeprops={'edgecolor': 'black', 'linewidth': 1}, textprops={'weight': 'bold'})\n",
        "plt.title('In the simulated dataset: Email Verification Status Proportion', weight='bold', pad=15)\n",
        "plt.tight_layout()\n",
        "plt.savefig('email_verification_pie.png', dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# C. Onboarding Status Bar Chart\n",
        "plt.figure(figsize=(8, 4.5))\n",
        "ax_onb = sns.countplot(data=user_rew_clean, x='onboarding_status', palette='magma', edgecolor='black', hue='onboarding_status', legend=False)\n",
        "for c in ax_onb.containers:\n",
        "    ax_onb.bar_label(c, weight='bold', padding=3)\n",
        "plt.title('In the simulated dataset: Onboarding Completion Distribution', weight='bold', pad=15)\n",
        "plt.xlabel('Onboarding Status')\n",
        "plt.ylabel('User Count')\n",
        "plt.tight_layout()\n",
        "plt.savefig('onboarding_status_bar.png', dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# D. Active 7d vs Active 30d Heatmap\n",
        "plt.figure(figsize=(6, 4.5))\n",
        "cross_tab_hmap = pd.crosstab(user_rew_clean['is_active_7d'], user_rew_clean['is_active_30d'])\n",
        "sns.heatmap(cross_tab_hmap, annot=True, fmt='d', cmap='Blues', cbar=False, annot_kws={'weight': 'bold', 'size': 14})\n",
        "plt.title('In the simulated dataset: Active 7d vs Active 30d Activity Matrix', weight='bold', pad=15)\n",
        "plt.xlabel('Active in Last 30 Days (Yes/No)')\n",
        "plt.ylabel('Active in Last 7 Days (Yes/No)')\n",
        "plt.tight_layout()\n",
        "plt.savefig('active_7d_vs_30d_heatmap.png', dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# E. XP Balance Histogram\n",
        "plt.figure(figsize=(10, 5))\n",
        "sns.histplot(data=user_rew_clean, x='xp_balance', bins=30, color='purple', kde=True, edgecolor='black')\n",
        "plt.title('In the simulated dataset: Overall XP Balance Frequency Distribution', weight='bold', pad=15)\n",
        "plt.xlabel('XP Balance')\n",
        "plt.ylabel('User Count')\n",
        "plt.tight_layout()\n",
        "plt.savefig('xp_balance_histogram.png', dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# F. User Lifecycle Segmentation Chart\n",
        "plt.figure(figsize=(8, 4.5))\n",
        "# Define segments\n",
        "def segment_lifecycle(row):\n",
        "    if row['days_since_registration'] <= 30:\n",
        "        return 'New'\n",
        "    elif row['is_active_30d'] == 'Yes':\n",
        "        return 'Active'\n",
        "    elif row['active_days'] == 0:\n",
        "        return 'Inactive'\n",
        "    else:\n",
        "        return 'Dormant'\n",
        "user_rew_clean['lifecycle_segment'] = user_rew_clean.apply(segment_lifecycle, axis=1)\n",
        "ax_lifecycle = sns.countplot(data=user_rew_clean, x='lifecycle_segment', palette='Set2', edgecolor='black', hue='lifecycle_segment', legend=False)\n",
        "for c in ax_lifecycle.containers:\n",
        "    ax_lifecycle.bar_label(c, weight='bold', padding=3)\n",
        "plt.title('In the simulated dataset: User Lifecycle Segmentation Distribution', weight='bold', pad=15)\n",
        "plt.xlabel('Lifecycle Segment')\n",
        "plt.ylabel('User Count')\n",
        "plt.tight_layout()\n",
        "plt.savefig('user_lifecycle_segmentation_chart.png', dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# G. Last Login Analysis Chart (Days Since Last Login for active logins)\n",
        "# Calculate days since last login relative to max login date\n",
        "max_date = user_rew_clean['last_login_datetime'].max()\n",
        "user_rew_clean['days_since_last_login'] = (max_date - user_rew_clean['last_login_datetime']).dt.days\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "sns.histplot(data=user_rew_clean.dropna(subset=['days_since_last_login']), x='days_since_last_login', bins=30, color='salmon', edgecolor='black', kde=True)\n",
        "plt.title('In the simulated dataset: Days Since Last Login Distribution', weight='bold', pad=15)\n",
        "plt.xlabel('Days Since Last Login')\n",
        "plt.ylabel('User Count')\n",
        "plt.tight_layout()\n",
        "plt.savefig('last_login_analysis_chart.png', dpi=300)\n",
        "plt.show()"
