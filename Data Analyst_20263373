        "# --- 4. Compare User Records Across Both Files ---\n",
        "print(\"=== User Record Conflict Analysis ===\")\n",
        "\n",
        "# Extract clean user lists\n",
        "beh_users = behavior_sheets.get('01_Users_1000')\n",
        "rew_users = rewards_sheets.get('Users_1000_Clean')\n",
        "\n",
        "if beh_users is not None and rew_users is not None:\n",
        "    beh_ids = set(beh_users['user_id'].dropna().unique())\n",
        "    rew_ids = set(rew_users['user_id'].dropna().unique())\n",
        "\n",
        "    common_ids = beh_ids.intersection(rew_ids)\n",
        "    only_beh = beh_ids - rew_ids\n",
        "    only_rew = rew_ids - beh_ids\n",
        "\n",
        "    print(f\"\\nUnique User IDs in Behavior Workbook: {len(beh_ids)}\")\n",
        "    print(f\"Unique User IDs in Rewards Workbook: {len(rew_ids)}\")\n",
        "    print(f\"User IDs appearing in both: {len(common_ids)}\")\n",
        "    print(f\"User IDs ONLY in Behavior: {len(only_beh)}\")\n",
        "    print(f\"User IDs ONLY in Rewards: {len(only_rew)}\")\n",
        "\n",
        "    # Compare matching rows for consistency\n",
        "    beh_common = beh_users[beh_users['user_id'].isin(common_ids)].set_index('user_id').sort_index()\n",
        "    rew_common = rew_users[rew_users['user_id'].isin(common_ids)].set_index('user_id').sort_index()\n",
        "\n",
        "    # We compare standard attributes like email or registration time\n",
        "    shared_cols = [c for c in beh_common.columns if c in rew_common.columns and c not in ['full_name', 'email', 'age', 'gender', 'state', 'city']]\n",
        "    print(f\"\\nComparing shared non-PII attributes: {shared_cols}\")\n",
        "\n",
        "    mismatches = 0\n",
        "    for col in shared_cols:\n",
        "        # Check if values match element-wise\n",
        "        series_beh = beh_common[col].astype(str).str.strip()\n",
        "        series_rew = rew_common[col].astype(str).str.strip()\n",
        "        diff_mask = series_beh != series_rew\n",
        "        mismatched_cnt = diff_mask.sum()\n",
        "        if mismatched_cnt > 0:\n",
        "            print(f\" - Field '{col}' has {mismatched_cnt} mismatches!\")\n",
        "            mismatches += mismatched_cnt\n",
        "\n",
        "    if mismatches == 0:\n",
        "        print(\"No structural metadata discrepancies found between matching User IDs.\")\n",
        "else:\n",
        "    print(\"Could not locate matching User sheets in both files.\")\n"
      ],
