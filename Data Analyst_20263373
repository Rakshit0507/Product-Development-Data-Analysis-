        "plt.figure(figsize=(9, 5))\n",
        "onboard_counts = user_rew_clean['onboarding_status'].value_counts()\n",
        "onboard_pcts = user_rew_clean['onboarding_status'].value_counts(normalize=True) * 100\n",
        "barplot_onb = sns.barplot(x=onboard_counts.index, y=onboard_counts.values, palette='viridis', edgecolor='black', hue=onboard_counts.index, legend=False)\n",
