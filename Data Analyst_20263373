        "    height = p.get_height()\n",
        "    barplot_onb.annotate(f\"{int(height)} ({onboard_pcts.values[i]:.1f}%)\",\n",
        "                         (p.get_x() + p.get_width() / 2., height),\n",
        "                         ha='center', va='bottom', fontsize=11, fontweight='bold', xytext=(0, 5),\n",
        "                         textcoords='offset points')\n",
        "plt.title('In the simulated dataset: Onboarding Completion Status Distribution', fontweight='bold', pad=15)\n",
        "plt.xlabel('Onboarding Status')\n",
        "plt.ylabel('User Count')\n",
        "plt.ylim(0, 820)\n",
        "plt.tight_layout()\n",
        "plt.savefig('scope_b_onboarding_status.png', dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# 2. XP Balance Distribution Chart\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.histplot(data=user_rew_clean, x='xp_balance', hue='lifecycle_segment', multiple='stack', palette='magma', bins=30, edgecolor='black')\n",
